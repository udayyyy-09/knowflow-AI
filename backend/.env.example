# ==============================================================================
# KnowFlow AI — Environment Configuration Template
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=django-insecure-knowflow-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Django Settings Module ---
# Options: config.settings.development, config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database (PostgreSQL + pgvector) ---
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://udaychaudhary@localhost:5432/knowflow_db

# --- Cache & Task Broker (Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT Authentication & Cookie Settings ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# In local dev: Secure=False, SameSite=Lax
# In production with HTTPS: Secure=True, SameSite=Lax (or 'None' for cross-domain staging)
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# Set in production if using custom domain, e.g. .knowflow.ai
# JWT_COOKIE_DOMAIN=.knowflow.ai

# --- Google OAuth Settings ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Select "OAuth 2.0 Client IDs" -> Web Application
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- CORS Settings (Frontend URLs) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ALLOWED_ORIGINS=https://app.knowflow.ai,https://knowflow-ai.vercel.app

# --- Embeddings & AI Providers ---
# Provider options: 'huggingface', 'gemini', 'local', 'openai', 'mock'
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-token-from-settings/tokens
GROQ_API_KEY=your-groq-api-key-from-console.groq.com

# --- LLM Generation & Multi-Tier Cascading RAG Configuration ---
# Provider options: 'cascade' (HF -> Groq -> Gemini), 'huggingface', 'groq', 'gemini', 'openai', 'mock'
LLM_PROVIDER=cascade
LLM_MODEL_NAME=meta-llama/Llama-3.1-8b-instruct
HF_MODEL_NAME=meta-llama/Llama-3.1-8b-instruct
GROQ_MODEL_NAME=llama-3.1-8b-instant
GEMINI_MODEL_NAME=gemini-2.0-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# --- Langfuse Prompt Management & Observability ---
# Sign up free at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=600

