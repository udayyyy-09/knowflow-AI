# ==============================================================================
# KnowFlow AI — Environment Configuration Template
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SECRET_KEY=django-insecure-knowflow-dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Django Settings Module ---
# Options: config.settings.development, config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database (PostgreSQL + pgvector) ---
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://udaychaudhary@localhost:5432/knowflow_db

# --- Cache & Task Broker (Redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT Authentication Settings ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Google OAuth Settings ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Select "OAuth 2.0 Client IDs" -> Web Application
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- CORS Settings (Frontend URLs) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Embeddings & AI Providers ---
# Provider options: 'openai', 'gemini', 'mock'
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
# For Gemini: EMBEDDING_PROVIDER=gemini, EMBEDDING_MODEL_NAME=gemini-embedding-001, EMBEDDING_DIMENSIONS=1536
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

